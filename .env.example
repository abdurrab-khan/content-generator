# ---------- Database ----------
POSTGRES_USER=content
POSTGRES_PASSWORD=content
POSTGRES_DB=content_generator

REDIS_PASS=content

# ---------- App ----------
NODE_ENV=production
PORT=3000

# ---------- Infrastructure ----------
DATABASE_URL=postgresql://content:content@postgres:5432/content_generator
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Auth (better-auth) ----------
BETTER_AUTH_SECRET="SECRET"
BETTER_AUTH_URL=http://localhost:3000

# ---------- AI (MODEL via LangChain) ----------
# MODEL_BASE_URL="https://groq.com"
MODEL_API_KEY="API_KEY"
AI_MODEL="deepseek/deepseek-v4-flash-0731"
AI_TEMPERATURE=0.3

# ---------- Storage ----------
STORAGE_ROOT=/usr/src/clip-forge-api/storage

# ---------- Ngrok ----------
NGROK_AUTHTOKEN="AUTHTOKEN"

# ---------- Binaries ----------
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------- Pipeline tuning ----------
CHUNK_MINUTES=9
CHUNK_OVERLAP_SECONDS=30
ANALYSIS_CONCURRENCY=5
CLIP_CUTTING_CRON="*/2 * * * *"
