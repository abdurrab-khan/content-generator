# ---------- App ----------
NODE_ENV=development
PORT=3000

# ---------- Infrastructure ----------
DATABASE_URL=postgresql://content:content@localhost:5432/content_generator
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Auth (better-auth) ----------
# Must be at least 32 characters
BETTER_AUTH_SECRET=change-me-to-a-very-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# ---------- AI (MODEL via LangChain) ----------
MODEL_BASE_URL=""
MODEL_API_KEY=""
AI_MODEL="qwen/qwen3.7-flash"
AI_TEMPERATURE=0.3

# ---------- Storage ----------
STORAGE_ROOT=./storage

# ---------- Binaries ----------
# defaults assume binaries are on PATH; point to files directly if not
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------- Pipeline tuning ----------
CHUNK_MINUTES=9
CHUNK_OVERLAP_SECONDS=30
ANALYSIS_CONCURRENCY=5
CLIP_CUTTING_CRON=*/2 * * * *

# ---------- Seed (dev only) ----------
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=password123
DEV_USER_NAME=Dev User
