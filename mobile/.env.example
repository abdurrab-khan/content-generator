# Base URL of the content-generator API (include the /api suffix).
# Leave unset to auto-derive from the Expo dev-server host (works when the
# phone/emulator can reach your dev machine). Set explicitly when needed:
#
#   Android emulator:  http://10.0.2.2:3000/api
#   Physical device:   http://<your-computer-LAN-IP>:3000/api
#
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api
